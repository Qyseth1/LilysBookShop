<Window
    x:Class="LilysBookShop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:LilysBookShop"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Lily's Bookshop"
    Width="1100"
    Height="880"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">

    <!--  When auth works: If I am logged in, then I can see more option like I can add books to bookshop,  -->

    <Window.Background>

        <ImageBrush ImageSource="Images/MainBackground.png" Stretch="UniformToFill" />
    </Window.Background>

    <Window.Resources>

        <!--  Colors  -->
        <SolidColorBrush x:Key="PrimaryColor" Color="#000000" />
        <SolidColorBrush x:Key="SecondaryColor" Color="#A67B5B" />
        <SolidColorBrush x:Key="Transparent" Color="#80606060" />
        <SolidColorBrush x:Key="TextColor" Color="#F7D7FC" />

        <!--  Button Style  -->
        <Style x:Key="MainButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PrimaryColor}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="18,10" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="5" />
        </Style>

        <!--  StackPanel Style  -->
        <Style x:Key="StackPanelStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Transparent}" />
            <Setter Property="CornerRadius" Value="15" />
            <Setter Property="Padding" Value="20" />
            <Setter Property="Margin" Value="8" />
        </Style>

    </Window.Resources>


    <DockPanel>

        <!--  Menu  -->
        <Menu
            Padding="8"
            Background="#E3E3E3"
            DockPanel.Dock="Top"
            Foreground="Black">

            <MenuItem Header="_File">
                <MenuItem Command="{Binding NewCommand}" Header="_New" />
                <MenuItem Command="{Binding OpenCommand}" Header="_Open" />
                <MenuItem Command="{Binding SaveCommand}" Header="_Save" />
                <Separator />
                <MenuItem Command="{Binding ExitCommand}" Header="_Exit" />
            </MenuItem>

            <MenuItem Header="_Help">
                <MenuItem Command="{Binding AboutCommand}" Header="_About" />
            </MenuItem>

        </Menu>


        <!--  Main Content  -->
        <ScrollViewer VerticalScrollBarVisibility="Auto">

            <Grid Margin="30">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>


                <!--  Header  -->

                <Grid Grid.Row="0">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>


                    <!--  Logo/Title  -->

                    <StackPanel Grid.Column="0">

                        <TextBlock
                            FontSize="32"
                            FontWeight="Bold"
                            Foreground="#F0BAFF"
                            Text="Lily's Bookshop" />

                        <TextBlock
                            Margin="0,5,0,0"
                            FontSize="15"
                            Foreground="White"
                            Text="Discover your next great story." />

                    </StackPanel>


                    <!--  ADMIN  -->

                    <Border
                        Grid.Column="1"
                        Margin="10,0,10,0"
                        Padding="10,10"
                        Background="#D6BB92"
                        CornerRadius="12">

                        <Button
                            Padding="12,5"
                            Command="{Binding AdminCommand}"
                            Content="⚙ Admin"
                            Style="{StaticResource MainButton}" />

                    </Border>


                    <!--  LOGIN  -->

                    <Border
                        Grid.Column="2"
                        Margin="10,0,0,0"
                        Padding="15,10"
                        Background="#E0C99B"
                        CornerRadius="12">

                        <StackPanel Orientation="Horizontal">

                            <TextBlock
                                Margin="0,0,8,0"
                                VerticalAlignment="Center"
                                FontSize="20"
                                Text="👤" />

                            <StackPanel>

                                <TextBlock
                                    FontWeight="SemiBold"
                                    Foreground="Black"
                                    Text="Welcome!" />

                                <Button
                                    Padding="12,5"
                                    Command="{Binding LoginCommand}"
                                    Content="Login"
                                    Style="{StaticResource MainButton}" />

                            </StackPanel>

                        </StackPanel>

                    </Border>

                </Grid>

                <!--  WELCOME  -->

                <Border
                    Grid.Row="1"
                    Margin="0,25,0,20"
                    Padding="25"
                    Background="{StaticResource Transparent}"
                    CornerRadius="18">

                    <StackPanel>

                        <TextBlock
                            FontSize="24"
                            FontWeight="Bold"
                            Foreground="#E4D5EB"
                            Text="Välkommen till Lily's Bookshop! 📚" />

                        <TextBlock
                            Margin="0,8,0,0"
                            FontSize="15"
                            Foreground="White"
                            Text="Find books to buy, discover recommendations, or borrow your next adventure from our library."
                            TextWrapping="Wrap" />

                    </StackPanel>

                </Border>


                <!--  RECOMMENDED BOOKS  -->

                <StackPanel Grid.Row="2">

                    <TextBlock
                        Margin="5,5,0,10"
                        FontSize="22"
                        FontWeight="Bold"
                        Foreground="#FFB0F2"
                        Text="Recommended Books" />

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>


                        <!--  Book 1  -->

                        <Border Grid.Column="0" Style="{StaticResource StackPanelStyle}">

                            <StackPanel>

                                <TextBlock
                                    HorizontalAlignment="Center"
                                    FontSize="45"
                                    Foreground="#E0C99B"
                                    Text="📕" />

                                <TextBlock
                                    Margin="0,8,0,2"
                                    HorizontalAlignment="Center"
                                    FontSize="17"
                                    FontWeight="Bold"
                                    Foreground="{StaticResource TextColor}"
                                    Text="The Great Adventure" />

                                <TextBlock
                                    HorizontalAlignment="Center"
                                    Foreground="White"
                                    Text="Adventure • Fiction" />

                                <Button
                                    Command="{Binding ViewBookCommand}"
                                    Content="View Book"
                                    Style="{StaticResource MainButton}" />

                            </StackPanel>

                        </Border>


                        <!--  Book 2  -->

                        <Border Grid.Column="1" Style="{StaticResource StackPanelStyle}">

                            <StackPanel>

                                <TextBlock
                                    HorizontalAlignment="Center"
                                    FontSize="45"
                                    Foreground="#E0C99B"
                                    Text="📕" />

                                <TextBlock
                                    Margin="0,8,0,2"
                                    HorizontalAlignment="Center"
                                    FontSize="17"
                                    FontWeight="Bold"
                                    Foreground="{StaticResource TextColor}"
                                    Text="A World Within" />

                                <TextBlock
                                    HorizontalAlignment="Center"
                                    Foreground="White"
                                    Text="Fantasy • Young Adult" />

                                <Button
                                    Command="{Binding ViewBookCommand}"
                                    Content="View Book"
                                    Style="{StaticResource MainButton}" />

                            </StackPanel>

                        </Border>


                        <!--  Book 3  -->

                        <Border Grid.Column="2" Style="{StaticResource StackPanelStyle}">

                            <StackPanel>

                                <TextBlock
                                    HorizontalAlignment="Center"
                                    FontSize="45"
                                    Foreground="#E0C99B"
                                    Text="📕" />

                                <TextBlock
                                    Margin="0,8,0,2"
                                    HorizontalAlignment="Center"
                                    FontSize="17"
                                    FontWeight="Bold"
                                    Foreground="{StaticResource TextColor}"
                                    Text="Mystery at Midnight" />

                                <TextBlock
                                    HorizontalAlignment="Center"
                                    Foreground="White"
                                    Text="Mystery • Thriller" />

                                <Button
                                    Command="{Binding ViewBookCommand}"
                                    Content="View Book"
                                    Style="{StaticResource MainButton}" />

                            </StackPanel>

                        </Border>

                    </Grid>

                </StackPanel>


                <!--  BOOKSHOP & LIBRARY  -->

                <Grid Grid.Row="3" Margin="0,25,0,10">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>


                    <!--  BOOKSHOP  -->

                    <Border
                        Grid.Column="0"
                        Margin="0,0,10,0"
                        Padding="25"
                        Background="#80606060"
                        CornerRadius="18">

                        <StackPanel>

                            <TextBlock
                                FontSize="23"
                                FontWeight="Bold"
                                Foreground="#D6B583"
                                Text="📚  Bookshop" />

                            <TextBlock
                                Margin="0,10,0,15"
                                FontSize="14"
                                Foreground="White"
                                Text="Explore our collection and find books available for purchase."
                                TextWrapping="Wrap" />

                            <Button
                                HorizontalAlignment="Left"
                                Background="#51B8C2"
                                Command="{Binding BrowseBooksCommand}"
                                Content="Browse Books"
                                Style="{StaticResource MainButton}" />

                            <Button
                                HorizontalAlignment="Left"
                                Background="#2FC23F"
                                Command="{Binding CartCommand}"
                                Content="🛒 View Shopping Cart"
                                Style="{StaticResource MainButton}" />

                        </StackPanel>

                    </Border>


                    <!--  LIBRARY  -->

                    <Border
                        Grid.Column="1"
                        Margin="10,0,0,0"
                        Padding="25"
                        Background="#80606060"
                        CornerRadius="18">

                        <StackPanel>

                            <TextBlock
                                FontSize="23"
                                FontWeight="Bold"
                                Foreground="#D6BB92"
                                Text="📖  Library" />

                            <TextBlock
                                Margin="0,10,0,15"
                                FontSize="14"
                                Foreground="White"
                                Text="Borrow books from our library collection and manage your loans."
                                TextWrapping="Wrap" />

                            <Button
                                HorizontalAlignment="Left"
                                Background="#51B8C2"
                                Command="{Binding BrowseLibraryCommand}"
                                Content="Browse Library"
                                Style="{StaticResource MainButton}" />

                            <Button
                                HorizontalAlignment="Left"
                                Background="#ABAAAD"
                                Command="{Binding MyLoansCommand}"
                                Content="My Borrowed Books"
                                Style="{StaticResource MainButton}" />

                        </StackPanel>
                    </Border>
                </Grid>

                <!--  TEST: USERS FROM DATABASE  -->
                <Border
                    Grid.Row="4"
                    Margin="0,20,0,10"
                    Padding="20"
                    Background="#80606060"
                    CornerRadius="18">

                    <StackPanel>

                        <TextBlock
                            Margin="0,0,0,10"
                            FontSize="23"
                            FontWeight="Bold"
                            Foreground="#D6B583"
                            Text="Users from Database" />

                        <Button
                            HorizontalAlignment="Left"
                            Command="{Binding SaveCommand}"
                            Content="Load Users"
                            Style="{StaticResource MainButton}" />

                        <DataGrid
                            Height="250"
                            Margin="0,10,0,0"
                            AutoGenerateColumns="True"
                            CanUserAddRows="False"
                            IsReadOnly="True"
                            ItemsSource="{Binding Users}" />

                    </StackPanel>

                </Border>
            </Grid>
        </ScrollViewer>
    </DockPanel>
</Window>